<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#161616" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <meta name="description" content="Bloom’innov — l’espace interne où les idées trouvent du soutien et une équipe." />
  <title>Bloom’innov — Les idées qui font avancer Bloomind</title>
  <link rel="icon" href="./assets/v8/favicon.svg" type="image/svg+xml" />
  <style data-build="20260814-8">
@charset "UTF-8";
:root {
  --ink: #171717;
  --ink-soft: #292929;
  --canvas: #F7F4ED;
  --surface: #ffffff;
  --surface-soft: rgba(255,255,255,.72);
  --primary: #FF5B35;
  --primary-rgb: 255,91,53;
  --secondary: #7257FF;
  --tertiary: #B7F44A;
  --sky: #8FD8FF;
  --muted: #6f6e69;
  --line: rgba(23,23,23,.12);
  --line-strong: rgba(23,23,23,.2);
  --success: #14875f;
  --danger: #d43f43;
  --idea: #7656f6;
  --progress: #ff6a3d;
  --completed: #16835f;
  --archived: #777671;
  --shadow-sm: 0 8px 24px rgba(27,24,18,.07);
  --shadow-md: 0 18px 50px rgba(27,24,18,.12);
  --shadow-lg: 0 40px 120px rgba(27,24,18,.2);
  --radius-sm: 12px;
  --radius-md: 20px;
  --radius-lg: 32px;
  --radius-xl: 48px;
  --font-display: "Arial Black", "Arial Narrow", Arial, sans-serif;
  --font-body: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  --ease-out: cubic-bezier(.16,1,.3,1);
  --ease-spring: cubic-bezier(.2,1.25,.4,1);
  --topbar-height: 78px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; background: var(--canvas); }
body { margin:0; min-width:320px; min-height:100vh; color:var(--ink); background:var(--canvas); font-family:var(--font-body); line-height:1.5; -webkit-font-smoothing:antialiased; overflow-x:hidden; }
body::selection { background:var(--tertiary); color:var(--ink); }
button,input,textarea,select { font:inherit; }
button { color:inherit; }
a { color:inherit; }
button:not(:disabled), select:not(:disabled) { cursor:pointer; }
svg { display:block; }
.icon { width:1.15em; height:1.15em; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; flex:none; }
.svg-sprite { position:absolute; pointer-events:none; }

.app-boot { min-height:100vh; display:grid; place-content:center; justify-items:center; gap:12px; background:var(--canvas); }
.app-boot strong { font:900 clamp(30px,5vw,56px)/1 var(--font-body); letter-spacing:-.06em; }
.app-boot span { color:var(--muted); }
.app-boot__flower { position:relative; width:72px; height:72px; animation:boot-spin 2.8s linear infinite; }
.app-boot__flower i { position:absolute; left:26px; top:2px; width:20px; height:34px; background:var(--primary); border-radius:100% 100% 60% 60%; transform-origin:10px 34px; }
.app-boot__flower i:nth-child(2){ transform:rotate(90deg); background:var(--secondary); }
.app-boot__flower i:nth-child(3){ transform:rotate(180deg); background:var(--tertiary); }
.app-boot__flower i:nth-child(4){ transform:rotate(270deg); background:var(--sky); }
.app-boot__flower b { position:absolute; inset:25px; border-radius:50%; background:var(--ink); }
@keyframes boot-spin { to { transform:rotate(360deg); } }

.app-shell { min-height:100vh; position:relative; isolation:isolate; }
.app-shell--modal-open { height:100vh; overflow:hidden; }
.ambient { position:fixed; z-index:-3; border-radius:50%; filter:blur(80px); pointer-events:none; opacity:.22; mix-blend-mode:multiply; animation:ambient-drift 16s ease-in-out infinite alternate; }
.ambient--one { width:420px; height:420px; left:-160px; top:18vh; background:var(--tertiary); }
.ambient--two { width:500px; height:500px; right:-220px; top:44vh; background:var(--secondary); animation-delay:-5s; }
.ambient--three { width:360px; height:360px; left:42%; bottom:-180px; background:var(--primary); animation-delay:-9s; }
@keyframes ambient-drift { 0%{ transform:translate3d(0,0,0) scale(.9);} 100%{ transform:translate3d(42px,-38px,0) scale(1.12);} }
.noise, .onboarding__noise { position:fixed; inset:0; z-index:90; pointer-events:none; opacity:.045; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E"); }
.cursor-aura { position:fixed; z-index:-1; width:280px; height:280px; margin:-140px 0 0 -140px; border-radius:50%; pointer-events:none; background:radial-gradient(circle, rgba(var(--primary-rgb),.13), transparent 67%); transform:translate3d(var(--cursor-x,-1000px),var(--cursor-y,-1000px),0); transition:opacity .3s; }

.topbar { position:sticky; top:0; z-index:70; height:var(--topbar-height); padding:0 clamp(18px,4vw,64px); display:flex; align-items:center; justify-content:space-between; gap:24px; background:color-mix(in srgb, var(--canvas) 83%, transparent); backdrop-filter:blur(18px) saturate(1.2); border-bottom:1px solid rgba(23,23,23,.07); }
.brand { border:0; background:none; padding:0; display:flex; align-items:center; gap:10px; white-space:nowrap; }
.brand__company { font-weight:900; font-size:19px; letter-spacing:-.06em; text-transform:lowercase; }
.brand__company span { color:var(--primary); }
.brand__separator { width:1px; height:22px; background:var(--line-strong); margin:0 2px; }
.brand__product { font-weight:800; letter-spacing:-.04em; }
.brand__beta { padding:3px 7px; border:1px solid var(--line-strong); border-radius:999px; font-size:9px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
.brand-mark { position:relative; display:inline-block; width:42px; height:42px; flex:none; animation:mark-float 6s ease-in-out infinite; }
.brand-mark i { position:absolute; left:15px; top:1px; width:12px; height:21px; border-radius:100% 100% 65% 65%; background:var(--primary); transform-origin:6px 20px; }
.brand-mark i:nth-child(2){ transform:rotate(90deg); background:var(--secondary); }
.brand-mark i:nth-child(3){ transform:rotate(180deg); background:var(--tertiary); }
.brand-mark i:nth-child(4){ transform:rotate(270deg); background:var(--sky); }
.brand-mark b { position:absolute; inset:14px; border-radius:50%; background:var(--ink); box-shadow:0 0 0 3px var(--canvas); }
.brand-mark--small { width:26px; height:26px; }
.brand-mark--small i { left:9px; width:8px; height:13px; transform-origin:4px 13px; }
.brand-mark--small b { inset:9px; box-shadow:0 0 0 2px var(--canvas); }
@keyframes mark-float { 0%,100%{transform:rotate(-3deg) translateY(0)} 50%{transform:rotate(4deg) translateY(-4px)} }

.desktop-nav { display:flex; align-items:center; gap:4px; padding:5px; border:1px solid var(--line); background:rgba(255,255,255,.42); border-radius:999px; }
.desk