; background:white; }
.detail-bento--wide { grid-column:1/-1; min-height:300px; background:color-mix(in srgb,var(--drawer-accent) 12%,white); }
.detail-bento__icon { width:48px; height:48px; margin-bottom:36px; display:grid; place-items:center; border-radius:15px; background:color-mix(in srgb,var(--primary) 18%,white); transform:rotate(-4deg); }
.detail-bento__icon--secondary { background:color-mix(in srgb,var(--secondary) 18%,white); }
.detail-bento__icon--tertiary { background:color-mix(in srgb,var(--tertiary) 42%,white); }
.detail-bento h3 { margin:8px 0 12px; font-size:28px; line-height:1.08; letter-spacing:-.045em; }
.detail-bento--wide h3 { font-size:clamp(32px,5vw,50px); }
.detail-bento p { margin:0; color:var(--muted); font-size:13px; }
.detail-team { display:flex; align-items:center; margin-top:24px; }
.detail-team .avatar + .avatar { margin-left:-9px; }
.detail-team button { width:38px; height:38px; margin-left:6px; display:grid; place-items:center; border:1px dashed var(--line-strong); border-radius:50%; background:transparent; }
.detail-section { grid-column:1/-1; margin-top:25px; padding-top:35px; border-top:1px solid var(--line); }
.detail-section__heading { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:22px; }
.detail-section__heading h3 { margin:7px 0 0; font-size:32px; letter-spacing:-.045em; }
.role-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.role-grid article { min-height:120px; padding:17px; display:flex; align-items:center; gap:14px; border:1px solid var(--line); border-radius:18px; background:white; transition:.2s; }
.role-grid article:hover { transform:translateY(-3px); box-shadow:var(--shadow-sm); }
.role-grid__icon { width:42px; height:42px; display:grid; place-items:center; border-radius:13px; background:var(--canvas); }
.role-grid article div { flex:1; }
.role-grid h4 { margin:0; font-size:13px; }
.role-grid p { margin:5px 0 0; color:var(--muted); font-size:10px; }
.role-grid article button { width:35px; height:35px; display:grid; place-items:center; border:1px solid var(--line); border-radius:50%; background:white; }
.open-contribution { padding:20px; display:flex; align-items:center; gap:16px; border:1px dashed var(--line-strong); border-radius:20px; }
.open-contribution > .icon { width:28px; height:28px; color:var(--secondary); }
.open-contribution > div { flex:1; }
.open-contribution strong { font-size:13px; }
.open-contribution p { margin:4px 0 0; color:var(--muted); font-size:11px; }
.count-badge { padding:6px 9px; border-radius:999px; background:color-mix(in srgb,var(--primary) 12%,white); color:var(--primary); font-size:9px; font-weight:800; }
.application-list { display:grid; gap:9px; }
.application-list article { padding:16px; display:flex; align-items:flex-start; gap:12px; border:1px solid var(--line); border-radius:18px; background:white; }
.application-list article > div:nth-child(2){flex:1}.application-list h4{margin:0;font-size:12px}.application-list h4 span{color:var(--muted);font-weight:500}.application-list p{margin:5px 0;color:var(--muted);font-size:11px}.application-list small{font-size:9px;color:var(--success)}.application-list__actions{display:flex;gap:6px}.application-list__actions .icon-button{width:34px;height:34px}
.drawer-enter-active,.drawer-leave-active { transition:.45s var(--ease-out); }
.drawer-enter-active .project-drawer,.drawer-leave-active .project-drawer { transition:.5s var(--ease-out); }
.drawer-enter-from,.drawer-leave-to { opacity:0; }
.drawer-enter-from .project-drawer,.drawer-leave-to .project-drawer { transform:translateX(105%) scale(.96); }

/* Forms */
.modal-layer { z-index:110; justify-content:center; align-items:center; overflow:auto; padding:24px; }
.form-modal,.join-modal,.confirm-modal { position:relative; width:min(760px,100%); max-height:calc(100vh - 48px); overflow:auto; border-radius:30px; background:var(--surface); box-shadow:var(--shadow-lg); }
.form-modal { padding:clamp(28px,5vw,55px); }
.form-modal .modal-close,.join-modal .modal-close { position:absolute; top:16px; right:16px; margin:0; float:none; color:var(--ink); background:var(--canvas); border-color:var(--line); }
.form-modal__intro { padding-right:55px; margin-bottom:32px; }
.form-modal__number { display:inline-grid; place-items:center; width:42px; height:42px; margin-bottom:24px; border-radius:50%; color:white; background:var(--ink); font-size:9px; font-weight:900; letter-spacing:.08em; }
.form-modal__intro h2,.join-modal__content h2,.confirm-modal h2 { margin:8px 0 12px; font-size:clamp(36px,5vw,58px); line-height:1; letter-spacing:-.065em; }
.form-modal__intro p,.join-modal__content > p,.confirm-modal p { margin:0; color:var(--muted); font-size:13px; }
.form-modal form,.join-modal form { display:grid; gap:18px; }
.form-field { position:relative; display:grid; gap:8px; }
.form-field > span,.status-choice > span { font-size:11px; font-weight:850; }
.form-field > span b,.status-choice > span b { color:var(--primary); }
.form-field > span small { color:var(--muted); font-weight:500; }
.form-field input,.form-field textarea,.form-field select { width:100%; border:1px solid var(--line-strong); border-radius:15px; padding:14px 15px; outline:0; color:var(--ink); background:var(--canvas); transition:.2s; }
.form-field textarea { resize:vertical; min-height:115px; }
.form-field input:focus,.form-field textarea:focus,.form-field select:focus { border-color:var(--ink); background:white; box-shadow:0 0 0 4px rgba(23,23,23,.05); }
.form-field > small { position:absolute; right:11px; bottom:8px; color:var(--muted); font-size:8px; }
.status-choice { display:grid; gap:10px; }
.status-choice > div { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
.status-choice label { min-height:100px; padding:13px; display:grid; align-content:start; gap:7px; border:1px solid var(--line); border-radius:15px; background:white; transition:.2s; }
.status-choice label:hover,.status-choice label.is-active { border-color:var(--ink); transform:translateY(-2px); box-shadow:var(--shadow-sm); }
.status-choice label.is-active { background:var(--canvas); }
.status-choice input { position:absolute; opacity:0; }
.status-choice strong { font-size:11px; }
.status-choice small { color:var(--muted); font-size:8px; line-height:1.35; }
.optional-toggle { width:100%; padding:14px 0; display:flex; align-items:center; justify-content:space-between; border:0; border-block:1px solid var(--line); background:none; text-align:left; }
.optional-toggle > span { display:grid; grid-template-columns:auto 1fr; gap:1px 10px; }
.optional-toggle > span .icon { grid-row:1/3; align-self:center; color:var(--secondary); }
.optional-toggle strong { font-size:11px; }
.optional-toggle small { color:var(--muted); font-size:9px; }
.optional-toggle > .icon { transition:.25s; }
.optional-toggle > .icon.is-rotated { transform:rotate(180deg); }
.optional-fields { display:grid; grid-template-columns:1fr 1fr; gap:13px; padding:4px 0