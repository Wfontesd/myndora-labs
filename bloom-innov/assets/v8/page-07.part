ale(1.9); }
.onboarding-network__center .brand-mark b { box-shadow:0 0 0 3px var(--ink); }
.onboarding-network__person { --angle:calc(var(--person)*72deg); position:absolute; z-index:3; left:50%; top:50%; display:grid; justify-items:center; gap:6px; transform:translate(-50%,-50%) rotate(var(--angle)) translateY(-210px) rotate(calc(var(--angle)*-1)); animation:person-pulse 4s ease-in-out infinite; animation-delay:calc(var(--person)*-.6s); }
.onboarding-network__person .avatar { width:64px; height:64px; font-size:17px; }
.onboarding-network__person small { padding:4px 8px; border-radius:999px; background:white; font-size:8px; font-weight:800; box-shadow:var(--shadow-sm); }
@keyframes person-pulse { 50%{margin-top:-12px;transform:translate(-50%,-50%) rotate(var(--angle)) translateY(-220px) rotate(calc(var(--angle)*-1)) scale(1.06)} }
.onboarding-ready { position:absolute; inset:3%; display:grid; place-content:center; justify-items:center; border-radius:50%; color:white; background:var(--ink); box-shadow:var(--shadow-lg); }
.onboarding-ready::before { content:""; position:absolute; inset:8%; border:1px solid rgba(255,255,255,.16); border-radius:50%; animation:slow-rotate 18s linear infinite; }
.onboarding-ready .brand-mark { transform:scale(3); margin:40px 0; }
.onboarding-ready .brand-mark b { box-shadow:0 0 0 3px var(--ink); }
.onboarding-ready__word { position:relative; z-index:2; font-size:clamp(52px,7vw,100px); line-height:.8; font-weight:950; letter-spacing:-.09em; }
.onboarding-ready__word--bottom { color:var(--tertiary); }
.onboarding-ready__badge { position:absolute; right:9%; top:13%; width:72px; height:72px; display:grid; place-content:center; border-radius:50%; color:var(--ink); background:var(--sky); font-size:8px; font-weight:900; letter-spacing:.12em; text-align:center; transform:rotate(12deg); }
.onboarding-users { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:27px; }
.onboarding-users button { padding:10px; display:flex; align-items:center; gap:9px; border:1px solid var(--line); border-radius:15px; background:rgba(255,255,255,.58); text-align:left; }
.onboarding-users button.is-active { border-color:var(--ink); background:white; box-shadow:var(--shadow-sm); }
.onboarding-users button > span:nth-child(2){flex:1}.onboarding-users strong,.onboarding-users small{display:block}.onboarding-users strong{font-size:11px}.onboarding-users small{font-size:9px;color:var(--muted)}
.onboarding__footer { position:absolute; z-index:12; left:clamp(24px,6vw,90px); right:clamp(24px,6vw,90px); bottom:25px; display:flex; align-items:center; justify-content:space-between; }
.onboarding__progress { display:flex; gap:7px; }
.onboarding__progress button { width:52px; height:16px; padding:0; border:0; background:transparent; }
.onboarding__progress span { display:block; width:100%; height:3px; border-radius:999px; background:rgba(23,23,23,.16); overflow:hidden; }
.onboarding__progress button.is-done span,.onboarding__progress button.is-active span { background:var(--ink); }
.onboarding__progress button.is-active span { animation:progress-grow .5s var(--ease-out); }
@keyframes progress-grow { from{transform:scaleX(.1);transform-origin:left} }
.onboarding__footer > div:last-child { display:flex; align-items:center; gap:14px; }
.onboarding-back,.onboarding-next { min-height:50px; border-radius:999px; padding:0 20px; display:flex; align-items:center; gap:8px; font-weight:850; }
.onboarding-back { border:0; background:transparent; }
.onboarding-next { border:0; color:white; background:var(--ink); box-shadow:var(--shadow-sm); }
.onboarding-next:hover { transform:translateX(3px); }
.onboarding-step-enter-active,.onboarding-step-leave-active { transition:.55s var(--ease-out); }
.onboarding-step-enter-from { opacity:0; transform:translateX(45px); }
.onboarding-step-leave-to { opacity:0; transform:translateX(-45px); }
.onboarding-enter-active,.onboarding-leave-active { transition:.55s var(--ease-out); }
.onboarding-enter-from,.onboarding-leave-to { opacity:0; clip-path:circle(0 at 50% 50%); }
.onboarding-enter-to,.onboarding-leave-from { clip-path:circle(150% at 50% 50%); }

/* Toasts and confetti */
.toast-stack { position:fixed; z-index:400; right:20px; bottom:20px; width:min(370px,calc(100vw - 40px)); display:grid; gap:9px; }
.toast { padding:14px; display:flex; align-items:flex-start; gap:11px; border:1px solid var(--line); border-radius:17px; background:rgba(255,255,255,.94); backdrop-filter:blur(18px); box-shadow:var(--shadow-md); }
.toast > span { width:35px; height:35px; display:grid; place-items:center; border-radius:11px; background:var(--canvas); }
.toast--success > span { color:var(--success); background:#eaf9f1; }
.toast--love > span { color:var(--primary); background:#fff0eb; }
.toast--info > span { color:var(--secondary); background:#f0edff; }
.toast > div { flex:1; }
.toast strong { font-size:11px; }
.toast p { margin:3px 0 0; color:var(--muted); font-size:9px; }
.toast > button { border:0; padding:3px; background:none; color:var(--muted); }
.toast-enter-active,.toast-leave-active { transition:.4s var(--ease-out); }
.toast-enter-from,.toast-leave-to { opacity:0; transform:translateX(35px) scale(.95); }
.confetti-layer { position:fixed; inset:0; z-index:500; pointer-events:none; overflow:hidden; }
.confetti { position:absolute; left:var(--x); top:var(--y); width:var(--size); height:calc(var(--size)*1.7); border-radius:2px; background:var(--color); animation:confetti-fall var(--duration) cubic-bezier(.12,.7,.35,1) forwards; transform:rotate(var(--rotation)); }
@keyframes confetti-fall { 0%{opacity:1;transform:translate(0,0) rotate(var(--rotation)) scale(1)} 100%{opacity:0;transform:translate(var(--drift),110vh) rotate(calc(var(--rotation) + 720deg)) scale(.5)} }

.reveal { opacity:0; transform:translateY(24px); transition:opacity .75s var(--ease-out),transform .75s var(--ease-out); }
.reveal.is-visible { opacity:1; transform:none; }
.page-enter-active,.page-leave-active { transition:.34s var(--ease-out); }
.page-enter-from { opacity:0; transform:translateY(18px); }
.page-leave-to { opacity:0; transform:translateY(-10px); }

@media (max-width:1180px){
  .desktop-nav{display:none}.hero-section{grid-template-columns:1fr .78fr}.hero-title{font-size:clamp(60px,8.5vw,95px)}.project-card{grid-column:span 6!important}.filter-panel{grid-template-columns:1fr auto}.filter-chips{order:3;grid-column:1/-1;overflow:auto}.activity-layout{grid-template-columns:1fr 310px}
}
@media (max-width:820px){
  :root{--topbar-height:66px}.desktop-only{display:none!important}.topbar{padding:0 15px}.brand__company,.brand__separator,.brand__beta{display:none}.brand{gap:7px}.brand__product{font-size:14px}.topbar__actions .primary-button{display:none}.profile-button{padding:0}.page{padding-inline:16px}.hero-section{min-height:auto;grid-template-columns:1fr;padding-block:65px 30px}.hero-orbit{width:min(88vw,510px);justify-self:center;margin-top:28px}.hero-title{font-size:clamp(53px,15vw,90px