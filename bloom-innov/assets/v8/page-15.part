  ];

  const ProjectCard = {
    template: '#project-card-template',
    components: {},
    props: {
      project: { type:Object, required:true }, index:{ type:Number, default:0 }, users:{type:Array,required:true}, currentUser:{type:Object,required:true}
    },
    emits:['open','vote'],
    setup(props,{emit}) {
      const tiltX = ref(0); const tiltY = ref(0); const bursting = ref(false);
      const userById = (id) => props.users.find((user) => user.id === id) || props.users[0];
      const owner = computed(() => userById(props.project.ownerId));
      const members = computed(() => props.project.memberIds.map(userById));
      const hasVoted = computed(() => props.project.votes.includes(props.currentUser.id));
      const initials = (name='') => name.split(/\s+/).map((part) => part[0]).join('').slice(0,2).toUpperCase();
      const avatarStyle = (user) => ({ '--avatar-bg': user?.avatarBg || '#ddd', '--avatar-ink': user?.avatarInk || '#222' });
      const statusLabel = (status) => ({ IDEA:'Idée', IN_PROGRESS:'En cours', COMPLETED:'Terminé', ARCHIVED:'Archivé' }[status] || status);
      const onTilt = (event) => {
        if (window.matchMedia('(hover: none)').matches) return;
        const rect = event.currentTarget.getBoundingClientRect();
        tiltY.value = ((event.clientX - rect.left) / rect.width - .5) * 5.5;
        tiltX.value = -((event.clientY - rect.top) / rect.height - .5) * 5.5;
      };
      const resetTilt = () => { tiltX.value = 0; tiltY.value = 0; };
      const pulseVote = (event) => {
        const button = event.currentTarget;
        button.classList.remove('is-bursting');
        void button.offsetWidth;
        button.classList.add('is-bursting');
        setTimeout(() => button.classList.remove('is-bursting'), 750);
        emit('vote', props.project);
      };
      return { tiltX,tiltY,owner,members,hasVoted,initials,avatarStyle,statusLabel,onTilt,resetTilt,pulseVote,bursting };
    }
  };

  const Icon = { template:'#icon-template', props:{ name:{type:String,required:true}, className:{type:String,default:''} } };
