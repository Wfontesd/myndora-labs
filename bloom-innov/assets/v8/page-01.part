top-nav button { position:relative; border:0; background:transparent; padding:10px 18px; border-radius:999px; font-size:13px; font-weight:700; color:var(--muted); transition:.25s var(--ease-out); }
.desktop-nav button:hover { color:var(--ink); }
.desktop-nav button.is-active { color:white; background:var(--ink); box-shadow:0 6px 16px rgba(0,0,0,.12); }
.topbar__actions { display:flex; align-items:center; gap:10px; }
.icon-button { width:44px; height:44px; border:1px solid var(--line); border-radius:50%; display:grid; place-items:center; background:var(--surface); transition:.25s var(--ease-out); }
.icon-button:hover { transform:translateY(-2px) rotate(2deg); box-shadow:var(--shadow-sm); }
.icon-button--soft { background:rgba(255,255,255,.6); }
.icon-button--danger { color:var(--danger); background:#fff1f1; border-color:rgba(212,63,67,.15); }
.icon-button--success { color:var(--success); background:#eaf9f1; border-color:rgba(20,135,95,.15); }
.primary-button,.secondary-button,.light-button,.danger-button { border:0; border-radius:999px; min-height:46px; padding:0 21px; display:inline-flex; align-items:center; justify-content:center; gap:10px; font-weight:800; letter-spacing:-.02em; transition:transform .28s var(--ease-spring), box-shadow .28s var(--ease-out), background .2s; }
.primary-button { color:white; background:var(--ink); box-shadow:0 8px 20px rgba(20,20,20,.14); }
.primary-button:hover { transform:translateY(-3px) scale(1.015); box-shadow:0 16px 34px rgba(20,20,20,.2); }
.primary-button:active { transform:translateY(0) scale(.98); }
.primary-button--compact { min-height:42px; padding:0 17px; font-size:13px; }
.primary-button--large { min-height:58px; padding:0 28px; font-size:15px; }
.secondary-button { background:var(--canvas); color:var(--ink); border:1px solid var(--line-strong); }
.light-button { min-height:58px; padding:0 27px; color:var(--ink); background:white; }
.light-button:hover { transform:translateY(-3px) rotate(-1deg); }
.danger-button { background:var(--danger); color:white; }
.text-button { border:0; padding:8px 0; background:none; display:inline-flex; align-items:center; gap:8px; font-weight:750; color:var(--ink); }
.text-button span { border-bottom:1px solid currentColor; }
.text-button:hover .icon { transform:translate(2px,-2px); }
.text-button .icon { transition:.2s; }
.magnetic { will-change:transform; }
.profile-switcher { position:relative; }
.profile-button { border:0; background:none; padding:3px 2px 3px 4px; display:flex; align-items:center; gap:9px; border-radius:999px; transition:.2s; }
.profile-button:hover { background:rgba(255,255,255,.6); }
.profile-button__copy { text-align:left; line-height:1.1; }
.profile-button__copy strong,.profile-button__copy small { display:block; }
.profile-button__copy strong { font-size:12px; }
.profile-button__copy small { font-size:10px; color:var(--muted); margin-top:3px; }
.avatar { width:38px; height:38px; display:inline-grid; place-items:center; border-radius:50%; flex:none; color:var(--avatar-ink,#161616); background:var(--avatar-bg,#ddd); font-size:12px; font-weight:900; letter-spacing:-.02em; border:2px solid rgba(255,255,255,.85); box-shadow:0 3px 10px rgba(0,0,0,.08); }
.avatar--sm { width:32px; height:32px; font-size:10px; }
.avatar--xs { width:27px; height:27px; font-size:9px; }
.avatar--more { background:var(--ink); color:white; }
.surface-popover { position:absolute; right:0; top:calc(100% + 12px); width:292px; padding:10px; border:1px solid var(--line); border-radius:20px; background:rgba(255,255,255,.94); backdrop-filter:blur(18px); box-shadow:var(--shadow-md); transform-origin:top right; }
.user-menu__header { padding:10px 10px 12px; }
.user-menu__header span,.user-menu__header small { display:block; }
.user-menu__header span { font-size:12px; font-weight:850; }
.user-menu__header small { margin-top:3px; font-size:10px; color:var(--muted); }
.user-menu > button { width:100%; border:0; background:transparent; padding:9px; border-radius:13px; display:flex; align-items:center; gap:10px; text-align:left; transition:.18s; }
.user-menu > button:hover,.user-menu > button.is-active { background:var(--canvas); }
.user-menu > button > span:nth-child(2) { flex:1; }
.user-menu > button strong,.user-menu > button small { display:block; }
.user-menu > button strong { font-size:12px; }
.user-menu > button small { margin-top:2px; color:var(--muted); font-size:10px; }
.user-menu__divider { height:1px; margin:7px 5px; background:var(--line); }
.popover-enter-active,.popover-leave-active { transition:.24s var(--ease-out); }
.popover-enter-from,.popover-leave-to { opacity:0; transform:translateY(-8px) scale(.96); }

main { position:relative; }
.page { width:min(1440px,100%); margin:0 auto; padding-inline:clamp(18px,5vw,76px); }
.page--board { padding-bottom:90px; }
.hero-section { min-height:calc(92vh - var(--topbar-height)); display:grid; grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr); align-items:center; gap:clamp(28px,5vw,90px); padding-block:clamp(65px,9vw,132px) 70px; }
.hero-section__copy { position:relative; z-index:2; }
.hero-kicker,.section-kicker { font-size:11px; line-height:1.2; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
.hero-kicker { display:flex; align-items:center; gap:9px; margin-bottom:23px; }
.live-dot { width:8px; height:8px; border-radius:50%; background:var(--success); box-shadow:0 0 0 0 rgba(20,135,95,.45); animation:live-pulse 2s infinite; }
@keyframes live-pulse { 70%{box-shadow:0 0 0 9px rgba(20,135,95,0)} 100%{box-shadow:0 0 0 0 rgba(20,135,95,0)} }
.hero-title { margin:0; font:900 clamp(60px,7.5vw,122px)/.88 var(--font-body); letter-spacing:-.085em; text-wrap:balance; }
.hero-title__accent { position:relative; display:inline-block; color:var(--primary); }
.hero-title__accent::after { content:""; position:absolute; left:3%; right:-3%; bottom:-7px; height:12px; background:var(--tertiary); border-radius:50%; z-index:-1; transform:rotate(-1.5deg) scaleX(.95); opacity:.8; }
.hero-title__rotator { display:inline-block; min-width:4.4ch; transition:color .4s; }
.hero-title__rotator--0 { color:var(--secondary); }
.hero-title__rotator--1 { color:var(--success); }
.hero-title__rotator--2 { color:var(--ink); }
.hero-lead { max-width:640px; margin:34px 0 0; font-size:clamp(17px,1.7vw,24px); line-height:1.45; letter-spacing:-.025em; color:#4b4a46; }
.hero-actions { display:flex; align-items:center; gap:24px; margin-top:36px; }
.hero-orbit { position:relative; width:min(42vw,610px); aspect-ratio:1; justify-self:end; }
.hero-orbit::before { content:""; position:absolute; inset:8%; border-radius:48% 52% 55% 45% / 48% 45% 55% 52%; background:linear-gradient(145deg,var(--primary),color-mix(in srgb,var(--primary) 25%,var(--secondary))); filter:saturate(.9); animation:blob-morph 12s ease-in-out infinite alternate; box-shadow:inset 0 0 80px rgba(255,255,255,.18),0 40px 90px rgba(var(--primary-rgb),.22); }
@keyframes blob-morph { 0%{border-radius:48% 52% 55% 45%/48